# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TOÀN BỘ DỰ ÁN POS MARKET
# ==============================================================================
# Luu ý: Ban can tao 2 file rieng biet o 2 thu muc frontend va backend
# dua tren cac mau duoi day. Khong day file .env that len ma nguon.

# ==============================================================================
# 1. CAU HINH CHO BACKEND (Luu vao file: backend/.env)
# ==============================================================================

# -- Co so du lieu (Database) --
# Chuoi ket noi den PostgreSQL Database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_pos?schema=public"

# -- Server va Bao mat --
PORT=4000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# -- Xac thuc JWT --
# Chuoi ky bi mat cho viec ma hoa JSON Web Token
JWT_SECRET="pos-market-jwt-secret-nhom8b-2026"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# -- Xac thuc NextAuth --
# Chuoi ky NextAuth can giong voi frontend
NEXTAUTH_SECRET="pos_market_nextauth_secret_example_string_2026"
NEXTAUTH_URL="http://localhost:3000"

# -- Cau hinh Gui Email --
# Su dung de gui hoa don PDF qua email cho khach hang
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="anpham5002@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="POS Market <noreply@posmarket.com>"

# -- Tri tue Nhan tao (AI Chatbot) --
# API Key cua Google Gemini 2.5 Flash
GEMINI_API_KEY="AQ.YOUR_NEW_AUTH_KEY_HERE"


# ==============================================================================
# 2. CAU HINH CHO FRONTEND (Luu vao file: frontend/.env.local)
# ==============================================================================

# -- Ket noi voi Backend --
# Dia chi URL mac dinh de frontend goi API den backend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# -- Cau hinh NextAuth --
# Bat buoc phai co de NextAuth hoat dong
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="pos_market_nextauth_secret_example_string_2026"

# -- Mien cho phep hien thi hinh anh --
NEXT_PUBLIC_IMAGE_DOMAINS="localhost,127.0.0.1"
