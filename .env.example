# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_pos?schema=public"

# NextAuth
NEXTAUTH_SECRET="your_super_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Backend API URL (for frontend)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Server Port (for backend)
PORT=4000

# JWT
JWT_SECRET="pos-market-secret-key-change-in-production"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# PayOS (Thanh toán QR — đăng ký tại https://payos.vn)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYOS_RETURN_URL="http://localhost:3000/pos"
PAYOS_CANCEL_URL="http://localhost:3000/pos"

