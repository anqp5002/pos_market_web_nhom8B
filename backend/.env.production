# ==========================================
# CẤU HÌNH PRODUCTION ENVIRONMENT (BACKEND)
# ==========================================

# Port lắng nghe của Express Server trong production
PORT=4000

# URL của cơ sở dữ liệu Supabase PostgreSQL
# Định dạng: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
# Ví dụ thực tế từ Supabase Connection String (Transaction mode - Pooler port 5432 hoặc 6543)
DATABASE_URL="postgresql://postgres.your-supabase-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=public"

# Hoặc cấu hình chi tiết cho Prisma Adapter pg Pool (được dùng trong source code config/db.ts)
DB_HOST="aws-0-us-east-1.pooler.supabase.com"
DB_PORT=5432
DB_USER="postgres.your-supabase-project-id"
DB_PASSWORD="your-supabase-password"
DB_NAME="postgres"

# JWT Secret - Khóa bí mật dùng để mã hóa Access Token và Refresh Token
# Hãy thay thế bằng một chuỗi ngẫu nhiên dài và bảo mật cao
JWT_SECRET="super-secret-production-jwt-key-pos-market-group-8b"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Địa chỉ Frontend phục vụ xác thực chéo nguồn (CORS)
FRONTEND_URL="https://pos-market-frontend.vercel.app"
NEXTAUTH_SECRET="super-secret-nextauth-production-key-group-8b"
