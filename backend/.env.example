# Server Port
PORT=4000

# Database URL (PostgreSQL/Neon/Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/web_pos?schema=public"

# JWT Auth Secret
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="7d"

# SMTP Email Configuration (Nodemailer)
# Nếu để trống, hệ thống sẽ tự động tạo tài khoản test Ethereal
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM='"POS Market" <noreply@posmarket.com>'
