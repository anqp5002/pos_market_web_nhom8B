# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES) CHO BACKEND
# ==============================================================================
# QUAN TRỌNG: Không bao giờ commit file .env thật của bạn lên GitHub!
# File này (.env.example) chỉ chứa các giá trị mẫu để hướng dẫn cách cài đặt.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE)
# ------------------------------------------------------------------------------
# Chuỗi kết nối đến PostgreSQL.
# Định dạng chuẩn: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
# Nếu bạn chạy qua Docker Desktop ở local, chuỗi kết nối mặc định sẽ là:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_pos?schema=public"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH SERVER VÀ BẢO MẬT CORE
# ------------------------------------------------------------------------------
# Port mà Backend sẽ chạy (Mặc định: 4000)
PORT=4000

# URL của Frontend (Dùng cho CORS và NextAuth Callback)
FRONTEND_URL="http://localhost:3000"

# URL của Backend (Dùng cho API Endpoint nội bộ)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH XÁC THỰC (JWT & NEXTAUTH)
# ------------------------------------------------------------------------------
# Chuỗi bí mật dùng để mã hóa NextAuth Session. Bạn có thể gõ bừa 1 chuỗi ngẫu nhiên.
# Mẫu: "your_super_secret_key_here" hoặc chạy `openssl rand -base64 32`
NEXTAUTH_SECRET="pos_market_nextauth_secret_example_string_2026"
NEXTAUTH_URL="http://localhost:3000"

# Chuỗi bí mật dùng để mã hóa JSON Web Token (JWT) trong Backend
JWT_SECRET="pos-market-jwt-secret-nhom8b-2026"

# Thời gian hết hạn của Token (Mặc định: 8 tiếng cho ca làm việc)
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH GỬI EMAIL (NODEMAILER)
# ------------------------------------------------------------------------------
# Hệ thống sử dụng Email để gửi Hóa đơn điện tử (PDF) cho Khách hàng.
# Khuyến nghị dùng Gmail SMTP. Bạn cần tạo "App Password" (Mật khẩu ứng dụng) trong Gmail.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="anpham5002@gmail.com" # Thay bằng Email của bạn
SMTP_PASS="xxxx xxxx xxxx xxxx" # Thay bằng Mật khẩu ứng dụng (16 ký tự, không chứa dấu cách)
EMAIL_FROM='"POS Market" <noreply@posmarket.com>'

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH TRÍ TUỆ NHÂN TẠO (AI CHATBOT)
# ------------------------------------------------------------------------------
# Hệ thống dùng Google Gemini 2.5 Flash làm AI Gợi ý mua kèm và Trợ lý ảo.
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
# CHÚ Ý: Key đúng luôn bắt đầu bằng chữ 'AIzaSy' hoặc định dạng Auth Key 'AQ.'
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"
